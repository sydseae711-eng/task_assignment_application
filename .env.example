# Used by docker-compose to pass through to the server container.
# Copy this file to .env and fill in your own key — get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the default Gemini model (defaults to gemini-3.5-flash-lite if unset)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: override the default subtask nesting limits (not spec-mandated — a deliberate
# sanity limit to prevent unbounded subtask trees, kept configurable since the exact
# numbers are a judgment call). Defaults: depth 3, 10 subtasks per level.
# MAX_SUBTASK_DEPTH=3
# MAX_SUBTASKS_PER_LEVEL=10

# Optional: override the default local Postgres credentials used by docker-compose.
# Only needed if you want different values — postgres/mysecretpassword/mydatabase work out of the box.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=mysecretpassword
# POSTGRES_DB=mydatabase
